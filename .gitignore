# Local tooling / IDE state
.claude/
.playwright-mcp/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Editor backup files
*.swp
*.swo
*~

# Screenshots and QA captures NEVER belong in the repo: every tracked file is
# publicly served by Cloudflare Pages. Save captures to the Claude scratchpad
# or Downloads instead. Root-level images are blocked wholesale; only the
# favicon/OG whitelist below is allowed at root.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
!/apple-touch-icon.png
!/favicon-96x96.png
!/preview.png
!/web-app-manifest-192x192.png
!/web-app-manifest-512x512.png

# Legacy screenshot name patterns (kept for subdirectory coverage)
drozq-la-*.png
sellersadvantage-la-*.png
verify-*.png

# Python bytecode
__pycache__/
*.pyc

# Google Ads API credentials (OAuth refresh token) - NEVER commit
scripts/.google_ads.json
scripts/.google_search_console.json

# Email platform shared secret (mirrors the EMAIL_SECRET Cloudflare env var) - NEVER commit
scripts/.email_secret

# Wrangler local state (from `npx wrangler pages dev` test runs)
.wrangler/

# Node / Worker build output
node_modules/
dist/
coverage/
*.tsbuildinfo
cloudflare/dashboard-worker/worker-configuration.d.ts

# Local Codex state
.codex/

# Local environment and Worker secrets. Examples remain tracked.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Fello Custom App credentials (API key + webhook HMAC client secret) - NEVER commit
scripts/.fello_secret
