# Cloudflare Pages static asset caching (added 2026-08-26 with the Panda CSS
# extraction). The stylesheet URL carries a content hash (?v=...), the fonts and
# the city thumbnails never change in place, so a year-long immutable cache is
# safe; HTML keeps Pages' default revalidation.
/media/css/*
  Cache-Control: public, max-age=31536000, immutable

/media/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/media/images/cities/*
  Cache-Control: public, max-age=2592000
