{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drozq-operating-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "drozq.com/api/dashboard*",
      "zone_name": "drozq.com"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "DASHBOARD_KV",
      "id": "4d387f23d1dd41d0976565e586bad72f"
    }
  ],
  "vars": {
    "FUB_SELLER_TAG": "Seller",
    "GOOGLE_ADS_API_VERSION": "v25",
    "REPORTING_TIME_ZONE": "America/Los_Angeles"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "upload_source_maps": true
}
