{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drozq-operating-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "drozq.com/api/dashboard*",
      "zone_name": "drozq.com"
    }
  ],
  "triggers": {
    // KV free tier allows 1,000 writes/day account-wide. Each sync run writes
    // lease + snapshot + FUB activity + FUB dial state (~4 writes), so the
    // cadence must keep runs*4 + source-cache refreshes well under the cap.
    // */10 = 144 runs/day ~= 650 writes/day. Do not tighten below */5 without
    // Workers Paid (the 2026-08-20 quota-exhaustion incident, DASHBOARD_SETUP.md §9).
    "crons": [
      "*/10 * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "DASHBOARD_KV",
      "id": "4d387f23d1dd41d0976565e586bad72f"
    }
  ],
  "vars": {
    "FUB_SELLER_TAG": "Seller",
    "FUB_ACCOUNT_HOST": "activerealty.followupboss.com",
    "FUB_CLOSED_DEAL_STAGE_NAMES": "Closed",
    "FUB_TEAM_EXCLUDED_USER_NAMES": "Active Agents",
    "FUB_TEAM_REFRESH_MINUTES": "30",
    "GOOGLE_ADS_API_VERSION": "v25",
    "GOOGLE_ADS_SELLER_CAMPAIGN_LAUNCH_DATE": "2026-08-17",
    "GOOGLE_SEARCH_CONSOLE_ACTIVE_REALTY_SITE_URL": "sc-domain:activerealty.com",
    "GOOGLE_SEARCH_CONSOLE_JT_SITE_URL": "https://justintye.com/",
    "GOOGLE_SEARCH_CONSOLE_REFRESH_MINUTES": "60",
    "REPORTING_TIME_ZONE": "America/Los_Angeles"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "upload_source_maps": true
}
