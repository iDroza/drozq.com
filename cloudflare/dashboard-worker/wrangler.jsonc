{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drozq-operating-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "drozq.com/api/dashboard*",
      "zone_name": "drozq.com"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "DASHBOARD_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "vars": {
    "FUB_SELLER_TAG": "Seller",
    "GOOGLE_ADS_API_VERSION": "v25",
    "GOOGLE_ADS_CUSTOMER_ID": "8004133723",
    "GOOGLE_ADS_LEAD_CONVERSION_ACTION_NAMES": "generate_lead",
    "REPORTING_TIME_ZONE": "America/Los_Angeles",
    "GOOGLE_SHEETS_PAGE_HEADER": "Page",
    "GOOGLE_SHEETS_STATUS_HEADER": "Status",
    "GOOGLE_SHEETS_COMPLETE_VALUES": "complete,completed,done,published,live"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "upload_source_maps": true
}
