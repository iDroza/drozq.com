# Copy this file to .dev.vars for local Worker development only.
# Replace every angle-bracket value. Never commit .dev.vars.

ADMIN_SYNC_TOKEN="<long-random-manual-sync-token>"

FUB_API_KEY="<follow-up-boss-api-key>"
FUB_TEAM_API_KEY="<optional-broker-or-owner-fallback-api-key>"
FUB_ACCOUNT_HOST="activerealty.followupboss.com"
FUB_X_SYSTEM="<optional-follow-up-boss-system-name>"
FUB_X_SYSTEM_KEY="<optional-follow-up-boss-system-key>"
FUB_SELLER_TAG="Seller"
FUB_ASSIGNED_USER_ID="<optional-follow-up-boss-user-id>"
FUB_CLOSED_DEAL_STAGE_NAMES="Closed"
FUB_TEAM_EXCLUDED_USER_NAMES="Active Agents"
FUB_TEAM_REFRESH_MINUTES="5"

GOOGLE_ADS_DEVELOPER_TOKEN="<google-ads-developer-token>"
GOOGLE_ADS_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_ADS_CLIENT_SECRET="<google-oauth-client-secret>"
GOOGLE_ADS_REFRESH_TOKEN="<google-oauth-refresh-token>"
GOOGLE_ADS_CUSTOMER_ID="<fallback-ten-digit-customer-id-without-hyphens>"
GOOGLE_ADS_LOGIN_CUSTOMER_ID="<ten-digit-manager-id-without-hyphens>"
GOOGLE_ADS_API_VERSION="v25"

GOOGLE_SEARCH_CONSOLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET="<google-oauth-client-secret>"
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN="<search-console-readonly-refresh-token>"
GOOGLE_SEARCH_CONSOLE_ACTIVE_REALTY_SITE_URL="sc-domain:activerealty.com"
GOOGLE_SEARCH_CONSOLE_JT_SITE_URL="https://justintye.com/"
GOOGLE_SEARCH_CONSOLE_REFRESH_MINUTES="60"

GOOGLE_SERVICE_ACCOUNT_EMAIL="<service-account-email>"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<service-account-private-key>\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID="<spreadsheet-id>"
GOOGLE_SHEETS_REMAINING_RANGE="<optional-shell-pages-direct-cell-range>"
GOOGLE_SHEETS_SETS_REMAINING_RANGE="<optional-sets-direct-cell-range>"
GOOGLE_SHEETS_PAGES_RANGE="<optional-shell-pages-table-range>"
GOOGLE_SHEETS_PAGE_HEADER="Page"
GOOGLE_SHEETS_STATUS_HEADER="Status"
GOOGLE_SHEETS_COMPLETE_VALUES="complete,completed,done,published,live"

REPORTING_TIME_ZONE="America/Los_Angeles"
