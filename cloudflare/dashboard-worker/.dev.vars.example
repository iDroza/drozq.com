# Copy this file to .dev.vars for local Worker development only.
# Replace every angle-bracket value. Never commit .dev.vars.

ADMIN_SYNC_TOKEN="<long-random-manual-sync-token>"

FUB_API_KEY="<follow-up-boss-api-key>"
FUB_X_SYSTEM="<optional-follow-up-boss-system-name>"
FUB_X_SYSTEM_KEY="<optional-follow-up-boss-system-key>"
FUB_SELLER_TAG="Seller"
FUB_ASSIGNED_USER_ID="<optional-follow-up-boss-user-id>"

GOOGLE_ADS_DEVELOPER_TOKEN="<google-ads-developer-token>"
GOOGLE_ADS_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_ADS_CLIENT_SECRET="<google-oauth-client-secret>"
GOOGLE_ADS_REFRESH_TOKEN="<google-oauth-refresh-token>"
GOOGLE_ADS_CUSTOMER_ID="<fallback-ten-digit-customer-id-without-hyphens>"
GOOGLE_ADS_LOGIN_CUSTOMER_ID="<ten-digit-manager-id-without-hyphens>"
GOOGLE_ADS_API_VERSION="v25"
REPORTING_TIME_ZONE="America/Los_Angeles"
